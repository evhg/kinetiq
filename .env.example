# Copy to .env.local for local testing. Never commit real values.
# On Vercel: Project → Settings → Environment Variables.

# Stripe secret key (test keys start with sk_test_). Without it, "Pay by Card" runs in preview mode.
# Prices come from src/content/site.ts, so no products need setting up in Stripe.
STRIPE_SECRET_KEY=

# Public site URL used for Stripe success/cancel links, e.g. https://kinetiq.example
NEXT_PUBLIC_SITE_URL=

# Set to "true" only when every row in CLAIMS.md is cleared: removes the preview banner and noindex.
NEXT_PUBLIC_LAUNCHED=
