# Copy to .env.local for local testing. Never commit real values.
# On Vercel: Project → Settings → Environment Variables.

# Stripe keys (test keys start with sk_test_ / pk_test_). Without them the reserve page runs in preview:
# the card field reads "Card payments open at launch" and Place Reservation stays disabled.
# Prices come from src/content/lineup.ts, so no products need setting up in Stripe.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Comma-separated invitation codes for the Invite Only edition (One of Ten, ten sets of three). The edition
# fails closed: while this is empty, or while INVITE_TERMS_READY in src/content/lineup.ts is false, its card says
# "Invitations open soon." and nobody can reserve it. Once both are set, One of Ten still shows locked until a
# visitor enters a valid code ("Have an invitation?" on /reserve, or a /reserve?invite=CODE link); /api/reserve
# checks the code again before any charge, and each code reserves one set. Use long random codes (12+ characters,
# e.g. KQ-7F3M-Q9TX-2LRA): the code check answers yes or no, so short codes can be guessed.
# Set it only once the One of Ten guarantee statement, the EU guarantee label and the coaching terms exist
# (CLAIMS.md rows 20, 21 and 29).
INVITE_CODES=

# Set to "true" only when every row in CLAIMS.md is cleared: removes noindex (search engines may index the site).
NEXT_PUBLIC_LAUNCHED=

# Optional: the site's public URL (https://…), used for absolute social-card links. On Vercel, the
# production domain is used when this is empty.
NEXT_PUBLIC_SITE_URL=

# Optional: set to 1 to serve the /lab graphic review pages in production (they are dev-only otherwise).
KQ_LAB=
