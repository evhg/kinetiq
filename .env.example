# Copy to .env.local for local testing. Never commit real values.
# On Vercel: Project → Settings → Environment Variables.

# Stripe (test keys start with sk_test_). Without these, checkout runs in preview mode.
STRIPE_SECRET_KEY=
STRIPE_PRICE_COMMAND=
STRIPE_PRICE_PACE=

# Public site URL used for Stripe success/cancel links, e.g. https://kinetiq.example
NEXT_PUBLIC_SITE_URL=

# Set to "true" only when every row in CLAIMS.md is cleared: removes the preview banner and noindex.
NEXT_PUBLIC_LAUNCHED=
