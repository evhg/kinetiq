# Copy to .env.local for local testing. Never commit real values.
# On Vercel: Project → Settings → Environment Variables.

# Stripe keys (test keys start with sk_test_ / pk_test_). Without them the reserve page runs in preview:
# the card field reads "Card payments open at launch" and Place Reservation stays disabled.
# Prices come from src/content/lineup.ts, so no products need setting up in Stripe.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Comma-separated invitation codes for the Invite Only edition (One of Ten, ten sets of three). The edition
# fails closed: while this is empty, or while INVITE_TERMS_READY in src/content/lineup.ts is false, its card says
# "Invitations open soon." and nobody can reserve it. Once both are set, One of Ten still shows locked until a
# visitor enters a valid code ("Have an invitation?" on /reserve, or a /reserve?invite=CODE link); /api/reserve
# checks the code again before any charge, and each code reserves one set. Use long random codes (12 characters or
# more, e.g. KQ-7F3M-Q9TX-2LRA): the code check answers yes or no, so short codes can be guessed. Shorter codes are
# ignored (src/lib/stripe-server.ts warns once, without printing them).
# Set it only once the One of Ten guarantee statement, the EU guarantee label and the coaching terms exist
# (CLAIMS.md rows 20, 21 and 29). One of Ten also stays closed while INVITE_ONE_USE_ENFORCED in
# src/lib/stripe-server.ts is false: the atomic one-use check it describes must exist before any code can pay.
INVITE_CODES=

# Set to "true" only when every row in CLAIMS.md is cleared: removes noindex (search engines may index the site).
NEXT_PUBLIC_LAUNCHED=

# Optional: the site's public URL (https://…), used for absolute social-card links. On Vercel, the
# production domain is used when this is empty.
NEXT_PUBLIC_SITE_URL=

# Optional: email the owner each time someone opens the presentation through the NDA gate (src/lib/nda-notify.ts).
# All three or nothing is sent; while all three are set, the gate says "We note your email for our NDA records".
# Set them on Vercel only (Production and Preview; mark the key Sensitive). The owner's address never goes in this repo.
# RESEND_API_KEY: a Resend API key with "Sending access" limited to the KINETIQ sending domain, ideally on an account
# or plan whose daily quota no other project shares. NDA_NOTIFY_FROM: a sender on that verified domain,
# e.g. "KINETIQ <nda@example.com>". NDA_NOTIFY_TO: the inbox that receives the sign-ins.
# The code caps the emails per server instance (once per address a day, 20 an hour, 40 a day; sign-ins over the caps
# are listed in the next email). The bound across instances is a Vercel Firewall rate-limit rule on POST /api/nda
# (about 5 a minute per IP): add it before setting these.
RESEND_API_KEY=
NDA_NOTIFY_TO=
NDA_NOTIFY_FROM=

# Optional: set to 1 to serve the /lab graphic review pages in production (they are dev-only otherwise).
KQ_LAB=
