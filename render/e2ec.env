# e2ec.env (2026-11-14): one-racket-e2ec.sh's exposures (EXPO_C / EXPO_P per frame), each set so the flat face's mean
# luma matches K01-full's (Command 137.4, Pace 44.0; e2e_face.py), found by renders at 1280x720 (phone 540x960) spp 64.
# C close-up, Cwide the K11 camera, Cph / Cwph their 2160x3840 phone frames. The Naked twins use their grip frame's.
EX_C_command=0.0891
EX_C_pace=0.3400
EX_Cwide_command=0.2496
EX_Cwide_pace=0.3687
EX_Cph_command=0.2154
EX_Cph_pace=0.1820
EX_Cwph_command=0.2585
EX_Cwph_pace=0.3198
