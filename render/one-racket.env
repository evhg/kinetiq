# one-racket.env: sourced by one-racket.sh / one-racket-k01np.sh before K01. Only K01's Naked Pace scene has a
# PaceHandle card. It sits 35 deg round the handle axis (KQ_PH_ROLL), where the flat face does not mirror it, and keeps
# its authored link, the handle only (KQ_ONE_RACKET_ASIS; cloud review 2026-11-14T05:47Z: unioned onto the whole racket
# it lit the Naked Pace face far brighter than Pace grip's; preview previews/wf/k01np-*: within 0.2 luma with ASIS).
unset KQ_ONE_RACKET_UNION
export KQ_ONE_RACKET_ASIS=PaceHandle_
export KQ_PH_ROLL=35
